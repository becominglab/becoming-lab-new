# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# HealthPlanet OAuth (TANITA)
HEALTHPLANET_CLIENT_ID=your-healthplanet-client-id
HEALTHPLANET_CLIENT_SECRET=your-healthplanet-client-secret
HEALTHPLANET_REDIRECT_URI=http://localhost:3000/api/healthplanet/callback

# Garmin Health API
GARMIN_CLIENT_ID=your-garmin-client-id
GARMIN_CLIENT_SECRET=your-garmin-client-secret
GARMIN_REDIRECT_URI=http://localhost:3000/api/garmin/callback

# COROS Open Platform
COROS_CLIENT_ID=your-coros-client-id
COROS_CLIENT_SECRET=your-coros-client-secret
COROS_REDIRECT_URI=http://localhost:3000/api/coros/callback
